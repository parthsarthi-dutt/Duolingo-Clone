# Copy to backend/.env to override. All settings are optional; these are the defaults.
# Real environment variables take precedence over this file.

# SQLite file (created and seeded on first start)
DATABASE_URL=sqlite:///./duolingo.db

# Origins allowed to call the API (comma separated). Set this to the deployed frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for extra origins, e.g. Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Minutes for one heart to regenerate
HEART_REGEN_MINUTES=240
